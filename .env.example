DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/vx_control
APP_PORT=3001
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Autenticación ---------------------------------------------------
# Ponlo a false solo en desarrollo: deja el panel y la API de lectura abiertos.
AUTH_ENABLED=true

# LLAVE MAESTRA. La tienes solo tú, y solo se cambia editando este fichero y
# reiniciando. Ninguna pantalla puede tocarla, y por eso nunca te puedes quedar
# fuera del panel hagan lo que hagan desde el navegador.
# Si la dejas vacía se genera una en cada arranque y se escribe en el log.
ADMIN_PASSWORD=vxloginadmin

# La clave de administración del día a día NO se pone aquí: se crea desde
# /admin entrando con la llave maestra, y a partir de ahí su dueño la rota él
# mismo sin tocar el servidor. Se guarda hasheada en la tabla app_settings.

# Clave de acceso inicial que se reparte al profesorado. Solo se usa la primera
# vez: a partir de ahí manda la copia guardada en base de datos, que se cambia
# desde /admin. Vacía => se genera una y se escribe en el log del primer arranque.
INITIAL_ACCESS_PASSWORD=vxlogindocente

# Firma de la cookie de sesión. Genérala con:  openssl rand -base64 32
# Si la dejas vacía, cada reinicio cierra todas las sesiones abiertas.
SESSION_SECRET=

# Duración de la sesión en segundos (43200 = 12 h).
SESSION_MAX_AGE=43200

# Ponlo a true cuando el panel se sirva por HTTPS.
COOKIE_SECURE=false

# Token opcional para POST /v1/report. DÉJALO VACÍO mientras haya equipos con
# versiones antiguas del cliente: al rellenarlo, la ingesta empieza a exigir la
# cabecera X-VX-Token y los equipos que no la envíen dejarán de reportar.
INGEST_TOKEN=
