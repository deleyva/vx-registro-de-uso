# Production environment for the vx-registro-de-uso systemd stack.
# Installed to /opt/vx-registro/.env by the .deb package (only if not already present).
# Edit credentials here, then: sudo systemctl restart vx-registro

# Docker image to run (override to pin a specific version instead of latest)
VX_IMAGE=ghcr.io/deleyva/vx-registro-de-uso:latest

# Postgres credentials — CHANGE THESE for a real deployment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vx_control

# App config
APP_PORT=3001
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Autenticación ---------------------------------------------------
# Las claves iniciales son PÚBLICAS y están en el README a propósito: esto se
# despliega en la red local del centro y tiene que funcionar nada más
# instalarlo. Se cambian desde /admin (la del profesorado y la de
# administración) o editando este fichero (la llave maestra).

# Llave maestra del panel. Solo se cambia aquí, y reiniciando el servicio.
ADMIN_PASSWORD=vxloginadmin

# Firma de la cookie de sesión. La genera postinst.sh, única de esta máquina.
# Esta NO es pública: publicarla permitiría falsificar sesiones sin conocer
# ninguna clave. Si cambia, se cierran todas las sesiones abiertas.
SESSION_SECRET=

AUTH_ENABLED=true
SESSION_MAX_AGE=43200

# Ponlo a true cuando el panel se sirva por HTTPS.
COOKIE_SECURE=false

# Clave de acceso inicial del profesorado. Solo se usa la primera vez: después
# manda la copia guardada en base de datos, que se cambia desde /admin.
INITIAL_ACCESS_PASSWORD=vxlogindocente

# Token opcional de ingesta. DÉJALO VACÍO mientras haya equipos con versiones
# antiguas del cliente: al rellenarlo dejarían de poder reportar.
INGEST_TOKEN=
